generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String?
  displayName  String?
  googleId     String? @unique
  avatarUrl    String?

  vocabularies Vocabulary[]
  settings     UserSettings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Vocabulary {
  id              String  @id @default(uuid())
  userId          String
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  word            String
  pronunciationUk String?
  pronunciationUs String?
  note            String?
  source          String  @default("manual")

  tags        VocabularyTag[]
  meanings    Meaning[]
  reviewState ReviewState?
  reviewLogs  ReviewLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([word])
  @@map("vocabularies")
}

model VocabularyTag {
  id           String     @id @default(uuid())
  vocabularyId String
  vocabulary   Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  tag String

  createdAt DateTime @default(now())

  @@unique([vocabularyId, tag])
  @@index([vocabularyId])
  @@index([tag])
  @@map("vocabulary_tags")
}

model Meaning {
  id           String     @id @default(uuid())
  vocabularyId String
  vocabulary   Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  partOfSpeech String
  definition   String
  translation  String?
  cefrLevel    String?
  orderIndex   Int     @default(0)

  examples Example[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vocabularyId])
  @@map("meanings")
}

model Example {
  id        String  @id @default(uuid())
  meaningId String
  meaning   Meaning @relation(fields: [meaningId], references: [id], onDelete: Cascade)

  sentence    String
  translation String?
  orderIndex  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([meaningId])
  @@map("examples")
}

model ReviewState {
  vocabularyId String     @id
  vocabulary   Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  stage           Int     @default(1)
  repetitionCount Int     @default(0)
  intervalDays    Int     @default(0)
  easeFactor      Decimal @default(2.50)

  lastReviewedAt DateTime?
  nextReviewAt   DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nextReviewAt])
  @@index([stage])
  @@map("review_states")
}

model ReviewLog {
  id           String     @id @default(uuid())
  vocabularyId String
  vocabulary   Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  rating               String
  previousStage        Int?
  nextStage            Int?
  previousIntervalDays Int?
  nextIntervalDays     Int?

  reviewedAt DateTime @default(now())

  @@index([vocabularyId])
  @@index([reviewedAt])
  @@map("review_logs")
}

model UserSettings {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stageThresholds Json @default("{\"1\":0,\"2\":1,\"3\":4,\"4\":15,\"5\":60}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}
