{
  "compilerOptions": {
    "target": "es2021",
    "lib": ["ESNext"],
    "module": "es2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true
  },
  "types": ["@cloudflare/vitest-pool-workers/types"],
  "exclude": ["node_modules"]
}
