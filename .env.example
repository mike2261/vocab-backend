NODE_ENV=development
PORT=4000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://vocab_user:vocab_password@localhost:5432/vocab_app?schema=public"

# JWT signing secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
# Frontend URL to redirect to after Google login, token appended as ?token=
GOOGLE_REDIRECT_FE_URL=http://localhost:3000/auth/callback

# OpenRouter LLM (https://openrouter.ai)
# Leave empty to use mock LLM response during development
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
